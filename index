<script>
// Student class: this simple class holds the portfolio details.
class Student {
  constructor(name, course, yearLevel, enrollmentStatus, email, subjects) {
    this.name = name;
    this.course = course;
    this.yearLevel = yearLevel;
    this.enrollmentStatus = enrollmentStatus;
    this.email = email;
    this.subjects = subjects;
  }
  // This method is called by the “Show Name & Section” demo button.
  printStudentNameAndSection() {
    return Student Name: ${this.name} | Section: ${this.section};
  }
}

// Create a Student object using Pia's portfolio details.
const student = new Student(
  "Pia Gianne M. Portento",
  "BS Information Technology",
  "3rd Year",
  "Currently Enrolled",
  "portentopm@students.national-u.edu.ph",
  ["Integrative Programming", "Advanced Mobile Programming", "Database Systems"]
);

// Add a new property after creating the object.
student.section = "INF246";

// Keep a copy of the starting values so Restore can undo the demo changes.
const originalStudentValues = {
  name: student.name, course: student.course, yearLevel: student.yearLevel,
  enrollmentStatus: student.enrollmentStatus, email: student.email,
  subjects: [...student.subjects], section: student.section
};

// Dot notation and destructuring: these values fill real portfolio content.
function renderPortfolioDetails() {
  const { name, course, yearLevel, enrollmentStatus, email, subjects } = student;
  const { name: studentName, course: studentCourse } = student;
  document.getElementById("heroName").textContent = student.name;
  document.getElementById("heroCourse").textContent = ${studentCourse} Student;
  document.getElementById("heroYear").textContent = student.yearLevel;
  document.getElementById("profileName").textContent = studentName;
  document.getElementById("heroStatus").textContent = student.enrollmentStatus;
  document.getElementById("heroSection").textContent = student.section;
  document.getElementById("educationCourse").textContent = course;
  document.getElementById("educationYear").textContent = yearLevel;
  document.getElementById("educationSection").textContent = Section ${student.section};
  document.getElementById("educationStatus").textContent = enrollmentStatus;
  document.getElementById("footerName").textContent = name;
  // Build the subject cards from the Student object's array, not hardcoded list items.
  document.getElementById("subjectList").innerHTML = subjects.map((subject, index) =>
    <article class="subject-card reveal"><span class="subject-no">0${index + 1} / CURRENT SUBJECT</span><h3>${subject}</h3></article>
  ).join("");
  observeNewCards();
  const hasEmail = Object.prototype.hasOwnProperty.call(student, "email");
  renderStudentDemo(hasEmail);
  renderContactEmail(email);
}

// Bracket notation: use property-name strings to read the Student object.
function renderStudentDemo(hasEmail) {
  const emailValue = hasEmail ? student["email"] : "Email property deleted";
  const fields = [
    ["Student Name", student["name"]], ["Course", student["course"]],
    ["Year Level", student["yearLevel"]], ["Enrollment Status", student["enrollmentStatus"]],
    ["Email", emailValue], ["Section", student["section"]]
  ];
  const fieldMarkup = fields.map(([label, value]) =>
    <div class="demo-field"><dt>${label}</dt><dd class="${label === "Email" && !hasEmail ? "is-deleted" : ""}">${value}</dd></div>
  ).join("");
  const subjectTags = student["subjects"].map(subject => <span>${subject}</span>).join("");
  document.getElementById("studentDetails").innerHTML = ${fieldMarkup}<div class="demo-field full"><dt>Subjects</dt><dd class="demo-subjects">${subjectTags}</dd></div>;
  document.getElementById("demoStatusBadge").textContent = hasEmail ? "Live data" : "Email removed";
  document.getElementById("deleteEmail").disabled = !hasEmail;
}

function renderContactEmail(email) {
  const contact = document.getElementById("contactEmail");
  contact.innerHTML = email
    ? <a class="email-link" href="mailto:${student["email"]}"><span aria-hidden="true"></span>${student["email"]}</a>
    : <span class="email-link">Email hidden in the object demo</span>;
}

// Update an existing property and show the change throughout the portfolio.
document.getElementById("updateStatus").addEventListener("click", () => {
  student.enrollmentStatus = student.enrollmentStatus === "Currently Enrolled" ? "Status Updated (Demo)" : "Currently Enrolled";
  document.getElementById("demoMessage").textContent = Enrollment status is now “${student.enrollmentStatus}”.;
  renderPortfolioDetails();
});

// Delete the email property only after the visitor presses the button.
document.getElementById("deleteEmail").addEventListener("click", () => {
  delete student.email;
  document.getElementById("demoMessage").textContent = "The email property was deleted from the Student object.";
  renderPortfolioDetails();
});

// Restore every starting value, including the email property and original status.
document.getElementById("restoreStudent").addEventListener("click", () => {
  Object.assign(student, originalStudentValues, { subjects: [...originalStudentValues.subjects] });
  document.getElementById("demoMessage").textContent = "Student details restored to the original portfolio values.";
  document.getElementById("methodOutput").textContent = "Use “Show Name & Section” to call the class method.";
  renderPortfolioDetails();
});

// Call the class method and show its returned name and section.
document.getElementById("showNameSection").addEventListener("click", () => {
  document.getElementById("methodOutput").textContent = student.printStudentNameAndSection();
});

// Personal places for the portfolio map. Milaor is the Camarines Sur spelling.
const personalPlaces = [
  { id: "cainta", type: "Current home", name: "Cainta, Rizal", region: "Rizal · CALABARZON", description: "My current home, just east of Metro Manila." },
  { id: "milaor", type: "Camarines Sur", name: "Milaor", region: "Camarines Sur · Bicol Region", description: "A municipality in Camarines Sur and one of the places on my personal map." },
  { id: "san-isidro", type: "Marinduque", name: "San Isidro", region: "Marinduque · MIMAROPA", description: "San Isidro in Marinduque is another place connected to me." }
];
function selectPersonalPlace(placeId) {
  const place = personalPlaces.find(item => item.id === placeId);
  if (!place) return;
  document.querySelectorAll(".map-marker").forEach(marker => {
    marker.classList.toggle("active", marker.dataset.place === placeId);
  });
  document.querySelectorAll(".place-choice").forEach(button => {
    button.classList.toggle("active", button.dataset.place === placeId);
  });
  document.getElementById("placeInfo").innerHTML = `
    <div class="place-type">${place.type}</div><h3>${place.name}</h3>
    <p>${place.description}</p><div class="place-region">${place.region}</div>`;
}
function renderPersonalPlaces() {
  document.getElementById("placeChoices").innerHTML = personalPlaces.map(place => `
    <button class="place-choice ${place.id === "cainta" ? "active" : ""}" data-place="${place.id}" type="button">
      <b>${place.name}${place.id === "cainta" ? " · Current home" : ""}</b><span>View on map </span>
    </button>`).join("");
  document.querySelectorAll(".place-choice, .map-marker").forEach(control => {
    control.addEventListener("click", () => selectPersonalPlace(control.dataset.place));
    control.addEventListener("keydown", event => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        selectPersonalPlace(control.dataset.place);
      }
    });
  });
}
renderPersonalPlaces();
// Responsive navigation menu for phones and small tablets.
const menuToggle = document.getElementById("menuToggle");
const navLinks = document.getElementById("navLinks");
menuToggle.addEventListener("click", () => {
  const isOpen = navLinks.classList.toggle("open");
  menuToggle.setAttribute("aria-expanded", isOpen);
  menuToggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
  menuToggle.textContent = isOpen ? "×" : "☰";
});
navLinks.querySelectorAll("a").forEach(link => link.addEventListener("click", () => {
  navLinks.classList.remove("open");
  menuToggle.setAttribute("aria-expanded", "false");
  menuToggle.setAttribute("aria-label", "Open navigation");
  menuToggle.textContent = "☰";
}));

// Reveal cards as they enter view, with a fallback for browsers without IntersectionObserver.
let revealObserver;
function observeNewCards() {
  const newCards = document.querySelectorAll(".reveal:not(.visible)");
  if (!("IntersectionObserver" in window)) {
    newCards.forEach(card => card.classList.add("visible"));
    return;
  }
  if (!revealObserver) {
    revealObserver = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
        revealObserver.unobserve(entry.target);
      }
    }), { threshold: 0.08 });
  }
  newCards.forEach(card => revealObserver.observe(card));
}

renderPortfolioDetails();
observeNewCards();
</script></body></html> 
